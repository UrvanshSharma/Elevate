# Elevate Environment Configuration Template
# Copy this file to .env and configure your environment variables:

# MongoDB Database Connection URI (MongoDB Atlas or local MongoDB instance)
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/elevate?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/elevate"

# JWT Secret for signing authentication & authorization tokens
JWT_SECRET="elevate_jwt_secret_2026_super_secure_key"

# Google Gemini API Key for AI resume parsing & live campus drives
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server Port (default 3000)
PORT=3000
